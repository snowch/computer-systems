+++ b/kernel/bio.c	2026-09-14 21:42:18.707710290 +0000
@@ -95,6 +95,7 @@
 
   b = bget(dev, blockno);
   if (!b->valid) {
+    blocknote(0); // Systems From Scratch, ch14: a block the cache did not have
     virtio_disk_rw(b, 0);
     b->valid = 1;
   }
@@ -108,6 +109,7 @@
 {
   if (!holdingsleep(&b->lock))
     panic("bwrite");
+  blocknote(1); // Systems From Scratch, ch14: a block on its way to the platter
   virtio_disk_rw(b, 1);
 }
 
@@ -151,3 +153,63 @@
   b->refcnt--;
   release(&bcache.lock);
 }
+
+
+// -- block census (Systems From Scratch, ch14) ----------------------------------------------
+//
+// Counts the traffic that actually reaches the device, which is not the same as the traffic a
+// program asked for and is the whole subject of ch14. A read that the buffer cache satisfies
+// never gets here; a block written twice in one transaction gets here once. What is left is what
+// the disk sees.
+//
+// Nothing is locked, for ch12's reason and with ch12's justification: a lock on the block path
+// would be work on the block path, and the figures the book publishes from this are the ones a
+// fixed workload fixes.
+
+struct blockcensus {
+  uint64 reads;
+  uint64 writes;
+  uint64 log_blocks;
+  uint64 commits;
+};
+
+struct blockcensus bcensus;
+
+void
+blocknote(int write)
+{
+  if (write)
+    bcensus.writes++;
+  else
+    bcensus.reads++;
+}
+
+void
+lognote(int commit)
+{
+  if (commit)
+    bcensus.commits++;
+  else
+    bcensus.log_blocks++;
+}
+
+// Printed on Ctrl-B, the way Ctrl-P prints the process table.
+void
+blockdump(void)
+{
+  printk("\nblockcensus 1\n");
+  printk("blockcensus reads %ld writes %ld logged %ld commits %ld\n", bcensus.reads,
+         bcensus.writes, bcensus.log_blocks, bcensus.commits);
+  printk("end blockcensus\n");
+}
+
+// Zeroed on Ctrl-Z, so that a workload can be measured without the boot in front of it.
+void
+blockreset(void)
+{
+  bcensus.reads = 0;
+  bcensus.writes = 0;
+  bcensus.log_blocks = 0;
+  bcensus.commits = 0;
+  printk("\nblockcensus reset\n");
+}
diff -urN a/kernel/console.c b/kernel/console.c
--- a/kernel/console.c	2026-09-14 21:42:18.681237911 +0000
+++ b/kernel/console.c	2026-09-14 21:42:18.708117029 +0000
@@ -152,6 +152,12 @@
   case C('T'): // Print the trap census (Systems From Scratch, ch08).
     trapdump();
     break;
+  case C('B'): // Print the block census (Systems From Scratch, ch14).
+    blockdump();
+    break;
+  case C('Z'): // Zero the block census (Systems From Scratch, ch14).
+    blockreset();
+    break;
   case C('X'): // Print the switch census (Systems From Scratch, ch13).
     switchdump();
     break;
