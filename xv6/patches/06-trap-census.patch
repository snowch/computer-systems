 extern int devintr();
 
+// -- trap census (Systems From Scratch, ch06) ---------------------------------------------
+//
+// Every trap into the kernel is counted, by cause. This exists because the book cannot time a
+// trap on this target -- QEMU models no pipeline and no memory, so a duration measured here
+// describes the laptop rather than RISC-V -- and counting is the honest alternative: how many
+// times the machine took this path, and why.
+//
+// scause's top bit distinguishes an interrupt from an exception and the remaining bits are the
+// cause within that class, so two arrays rather than one. Sixteen of each is enough for every
+// cause the privileged specification currently defines.
+#define NCAUSE 16
+
+struct trapcensus {
+  uint64 exception[NCAUSE];
+  uint64 interrupt[NCAUSE];
+  uint64 from_user;
+  uint64 from_kernel;
+  uint64 unclassified;
+};
+
+static struct trapcensus census;
+
+// Deliberately not locked. A count that is occasionally one short is a count; a lock on the trap
+// path would change the thing being measured, which is the mistake this whole book is about.
+static void
+census_note(uint64 scause, int user)
+{
+  uint64 code = scause & 0xf;
+  if (scause >> 63)
+    census.interrupt[code]++;
+  else if ((scause & ~(uint64)0xf) == 0)
+    census.exception[code]++;
+  else
+    census.unclassified++;
+
+  if (user)
+    census.from_user++;
+  else
+    census.from_kernel++;
+}
+
+// Printed on Ctrl-T at the console, the way Ctrl-P prints the process table. A system call would
+// be the other way to reach it, and ch06 leaves that to the reader.
+void
+trapdump(void)
+{
+  printk("trapcensus user %ld kernel %ld unclassified %ld\n", census.from_user,
+         census.from_kernel, census.unclassified);
+  for (int i = 0; i < NCAUSE; i++)
+    if (census.exception[i])
+      printk("trapcensus exception %d %ld\n", i, census.exception[i]);
+  for (int i = 0; i < NCAUSE; i++)
+    if (census.interrupt[i])
+      printk("trapcensus interrupt %d %ld\n", i, census.interrupt[i]);
+  printk("end trapcensus\n");
+}
+
