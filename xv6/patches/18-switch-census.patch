+
+
+// -- switch census (Systems From Scratch, ch18) ---------------------------------------------
+//
+// Every switch out of a process goes through sched(), so one counter there catches all of them;
+// what differs is why the process was there. yield() is the timer taking the CPU away, sleep() is
+// the process giving it up to wait, and kexit() is the process not coming back.
+//
+// The reason lives in struct proc rather than in a static, and the first version of this patch
+// put it in a static — which is ch17's race written by the author of ch17. Three harts reach
+// sched() whenever they like, so a single shared slot is set by one process and read by another,
+// and the count came out twice what the workload could possibly have caused. A per-process field
+// costs four bytes and cannot be got wrong that way.
+//
+// Only the exit count is a number a workload decides. A yield count is a statement about how many
+// timer interrupts happened, and a sleep count about whether what was waited for had already
+// happened; bench/run_switch.py records accordingly, for ch16's reasons.
+
+struct switchcensus {
+  uint64 switches;
+  uint64 by_yield;
+  uint64 by_sleep;
+  uint64 by_exit;
+};
+
+static struct switchcensus scensus;
+
+void
+switchnote(struct proc *p)
+{
+  scensus.switches++;
+  switch (p->switchreason) {
+  case 1: scensus.by_yield++; break;
+  case 2: scensus.by_sleep++; break;
+  case 3: scensus.by_exit++; break;
+  default: break;
+  }
+  p->switchreason = 0;
+}
+
+// Printed on Ctrl-X, the way Ctrl-P prints the process table.
+void
+switchdump(void)
+{
+  printk("\nswitchcensus 1\n");
+  printk("switchcensus total %ld yield %ld sleep %ld exit %ld\n", scensus.switches,
+         scensus.by_yield, scensus.by_sleep, scensus.by_exit);
+  printk("end switchcensus\n");
+}
