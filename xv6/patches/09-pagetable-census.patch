+// Print the page-table census: the kernel's own map, then one line per live process.
+// Systems From Scratch, ch09. Runs on Ctrl-V, mirroring Ctrl-P's convention above -- and, like
+// procdump, takes no lock, because a dump that can wedge the machine it is diagnosing is worse
+// than a dump that is occasionally one process out of date.
+void
+ptdump(void)
+{
+  struct proc *p;
+
+  printk("\nptcensus 1\n");
+  ptcensus(kernel_pagetable, "kernel", 0, "kernel");
+  for (p = proc; p < &proc[NPROC]; p++) {
+    if (p->state == UNUSED || p->pagetable == 0)
+      continue;
+    ptcensus(p->pagetable, "proc", p->pid, p->name);
+  }
+  printk("end ptcensus\n");
+}
