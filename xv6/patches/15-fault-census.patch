+// -- fault census (Systems From Scratch, ch15) --------------------------------------------
+//
+// Counters only. Nothing here changes a policy: this xv6 already offers both, as the second
+// argument to sbrk, and the book's job is to say what choosing between them costs. Per process,
+// because the shell is allocating too and a global total would be a fact about the shell.
+struct faultcensus {
+  uint64 eager_pages;   // pages uvmalloc allocated because somebody asked for them
+  uint64 lazy_pages;    // pages vmfault allocated because somebody touched them
+  uint64 load_faults;   // scause 13 reaching the handler
+  uint64 store_faults;  // scause 15 reaching the handler
+  uint64 refused;       // faults the handler declined: not this process's memory
+};
+
 struct proc {
   struct spinlock lock;
 
