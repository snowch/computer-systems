+
+
+// -- fault census (Systems From Scratch, ch15) ----------------------------------------------
+//
+// Counting only. This kernel already offers both allocation policies -- sbrk's second argument
+// picks one -- so the book has no policy to add and no business adding one. What it has is a
+// question neither policy answers by itself: what does choosing between them cost? That needs
+// pages allocated and faults taken, for the same workload, under each.
+//
+// The counters live in struct proc because the shell allocates too, and a global total would be
+// a statement about the shell. They are latched on the way out, because the interesting process
+// has usually exited by the time anybody presses a key.
+
+static struct faultcensus latched;
+static char latched_name[16];
+
+void
+census_page(int lazy)
+{
+  struct proc *p = myproc();
+
+  if (p == 0) // during boot there is nobody to charge it to
+    return;
+  if (lazy)
+    p->fc.lazy_pages++;
+  else
+    p->fc.eager_pages++;
+}
+
+void
+census_refused(void)
+{
+  struct proc *p = myproc();
+
+  if (p)
+    p->fc.refused++;
+}
+
+// Records the fault and returns vmfault's own answer unchanged, so the caller's logic is
+// undisturbed by being measured.
+uint64
+census_fault(uint64 scause, uint64 outcome)
+{
+  struct proc *p = myproc();
+
+  if (p) {
+    if (scause == 13)
+      p->fc.load_faults++;
+    else
+      p->fc.store_faults++;
+  }
+  return outcome;
+}
+
+void
+census_latch(struct proc *p)
+{
+  latched = p->fc;
+  safestrcpy(latched_name, p->name, sizeof(latched_name));
+}
+
+// Printed on Ctrl-F, the way Ctrl-P prints the process table. One line per live process and one
+// for the last process to leave, which is normally the one worth looking at.
+void
+faultdump(void)
+{
+  struct proc *p;
+
+  printk("\nfaultcensus 1\n");
+  for (p = proc; p < &proc[NPROC]; p++) {
+    if (p->state == UNUSED)
+      continue;
+    printk("faultcensus live %d %s eager %ld lazy %ld load %ld store %ld refused %ld\n", p->pid,
+           p->name, p->fc.eager_pages, p->fc.lazy_pages, p->fc.load_faults, p->fc.store_faults,
+           p->fc.refused);
+  }
+  printk("faultcensus exited %s eager %ld lazy %ld load %ld store %ld refused %ld\n",
+         latched_name[0] ? latched_name : "none", latched.eager_pages, latched.lazy_pages,
+         latched.load_faults, latched.store_faults, latched.refused);
+  printk("end faultcensus\n");
+}
