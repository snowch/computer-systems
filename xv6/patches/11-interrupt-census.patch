--- a/kernel/trap.c	2026-09-14 21:04:56.088299327 +0000
+++ b/kernel/trap.c	2026-09-14 21:04:56.125735821 +0000
@@ -16,6 +16,61 @@
 
 extern int devintr();
 
+// -- interrupt census (Systems From Scratch, ch11) -------------------------------------------
+//
+// One counter per source, plus the two facts about the console driver that say whether its
+// asynchronous machinery is doing anything: how many characters a writing process handed to the
+// device itself, and how many times it had to stop and wait for the device to catch up.
+//
+// Not locked, for the reason ch08's census is not locked: a lock on an interrupt path changes
+// the thing being measured.
+struct intrcensus {
+  uint64 timer;
+  uint64 uart;
+  uint64 virtio;
+  uint64 unexpected;
+  uint64 tx_wakeups;   // uartintr found the transmitter idle and woke a sleeper
+  uint64 rx_chars;     // characters uartintr took off the device
+  uint64 chars_written; // characters uartwrite handed to the device itself
+  uint64 write_sleeps;  // times uartwrite found the device busy and slept
+};
+
+struct intrcensus icensus;
+
+void
+intrnote(int source)
+{
+  switch (source) {
+  case 0: icensus.timer++; break;
+  case 1: icensus.uart++; break;
+  case 2: icensus.virtio++; break;
+  default: icensus.unexpected++; break;
+  }
+}
+
+void
+uartnote(int what, uint64 n)
+{
+  switch (what) {
+  case 0: icensus.tx_wakeups += n; break;
+  case 1: icensus.rx_chars += n; break;
+  case 2: icensus.chars_written += n; break;
+  default: icensus.write_sleeps += n; break;
+  }
+}
+
+// Printed on Ctrl-N, the way Ctrl-P prints the process table.
+void
+intrdump(void)
+{
+  printk("\nintrcensus 1\n");
+  printk("intrcensus source timer %ld uart %ld virtio %ld unexpected %ld\n", icensus.timer,
+         icensus.uart, icensus.virtio, icensus.unexpected);
+  printk("intrcensus console written %ld sleeps %ld wakeups %ld received %ld\n",
+         icensus.chars_written, icensus.write_sleeps, icensus.tx_wakeups, icensus.rx_chars);
+  printk("end intrcensus\n");
+}
+
 // -- trap census (Systems From Scratch, ch08) ---------------------------------------------
 //
 // Every trap into the kernel is counted, by cause, and every system call is counted by number.
